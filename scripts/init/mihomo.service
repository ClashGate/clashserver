[Unit]
Description=Mihomo (Clash Meta) server - clashserver
Documentation=https://wiki.metacubex.one/en/
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=mihomo
Group=mihomo
WorkingDirectory=/etc/clashserve
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# Unified root /etc/clashserve houses config, certs, panel, and runtime geodata/cache
Environment=SAFE_PATHS=/etc/clashserve:/etc/mihomo
ExecStartPre=+/usr/local/bin/clashserver migrate
ExecStartPre=/etc/clashserve/mihomo -t -d /etc/clashserve -f /etc/clashserve/config.yaml
ExecStart=/etc/clashserve/mihomo -d /etc/clashserve -f /etc/clashserve/config.yaml
# sh builtin kill: minimal Debian may lack procps' /bin/kill
ExecReload=/bin/sh -c 'kill -HUP $MAINPID'
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
