[Unit]
Description=clashserve panel (clashserver auto-cert mode)
After=network-online.target mihomo.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/etc/clashserve
# Runs as root so it can rewrite /etc/clashserve and call systemctl; serves HTTPS itself with the certificate in /etc/clashserve/certs.
ExecStartPre=+/usr/local/bin/clashserver migrate
ExecStart=/usr/bin/python3 /etc/clashserve/panel/panel.py serve --config /etc/clashserve/panel.json
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
