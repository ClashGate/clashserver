# Generated by clashserver (Clash Serve v0.5). Contains node credentials - keep private.
# Adapted from MetaCubeX official recommended client template & meta-rules-dat rulesets.
global-ua: clash.meta
mixed-port: 7890
allow-lan: false
bind-address: "*"
mode: rule
log-level: info
ipv6: true
unified-delay: true
tcp-concurrent: true
find-process-mode: strict
keep-alive-idle: 600
keep-alive-interval: 30

geodata-mode: false
geodata-loader: memconservative
geo-auto-update: true
geo-update-interval: 24
geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"
  asn: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/GeoLite2-ASN.mmdb"

profile:
  store-selected: true
  store-fake-ip: true

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: false
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]
  skip-domain:
    - "Mijia Cloud"
    - "+.push.apple.com"
    - "+.apple.com"
    - "+.wechat.com"
    - "+.qpic.cn"
    - "+.qq.com"

tun:
  enable: false
  stack: mixed
  auto-route: true
  auto-redirect: false
  auto-detect-interface: true
  dns-hijack:
    - any:53
    - tcp://any:53
  strict-route: true

dns:
  enable: true
  ipv6: true
  respect-rules: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "*.localhost"
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - "localhost.ptlogin2.qq.com"
    - "localhost.sec.qq.com"
    - "+.srv.nintendo.net"
    - "+.stun.playstation.net"
    - "xbox.*.microsoft.com"
    - "+.xboxlive.com"
    - "+.battlenet.com.cn"
    - "+.wotgame.cn"
    - "+.wggames.cn"
    - "+.wowsgame.cn"
    - "+.wargaming.net"
    - "stun.*.*"
    - "stun.*.*.*"
    - "+.stun.*.*"
    - "+.stun.*.*.*"
    - "+.stun.*.*.*.*"
    - "time.*.com"
    - "time.*.gov"
    - "time.*.apple.com"
    - "ntp.*.com"
    - "+.pool.ntp.org"
    - "+.market.xiaomi.com"
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  proxy-server-nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
  direct-nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
  nameserver:
    - https://dns.cloudflare.com/dns-query
    - https://dns.google/dns-query
  nameserver-policy:
    "rule-set:private_domain,cn_domain":
      - https://doh.pub/dns-query
      - https://dns.alidns.com/dns-query

proxies:
@@PROXIES@@

rule-providers:
  private_domain:
    type: http
    behavior: domain
    format: yaml
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/private.yaml"
    path: ./ruleset/private_domain.yaml
    interval: 86400
  AI-Global:
    type: http
    behavior: classical
    url: "https://cdn.jsdelivr.net/gh/VPSDance/ai-proxy-rules@main/rules/clash/global.yaml"
    path: ./ruleset/AI-Global.yaml
    interval: 86400
  AI-OpenAI:
    type: http
    behavior: classical
    url: "https://cdn.jsdelivr.net/gh/VPSDance/ai-proxy-rules@main/rules/clash/openai.yaml"
    path: ./ruleset/AI-OpenAI.yaml
    interval: 86400
  ai_non_cn:
    type: http
    behavior: domain
    format: yaml
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/category-ai-!cn.yaml"
    path: ./ruleset/ai_non_cn.yaml
    interval: 86400
  Twitter:
    type: http
    behavior: classical
    url: "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Twitter/Twitter.yaml"
    path: ./ruleset/Twitter.yaml
    interval: 86400
  Instagram:
    type: http
    behavior: classical
    url: "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Instagram/Instagram.yaml"
    path: ./ruleset/Instagram.yaml
    interval: 86400
  telegram_domain:
    type: http
    behavior: domain
    format: yaml
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/telegram.yaml"
    path: ./ruleset/telegram_domain.yaml
    interval: 86400
  telegram_ip:
    type: http
    behavior: ipcidr
    format: yaml
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/telegram.yaml"
    path: ./ruleset/telegram_ip.yaml
    interval: 86400
  youtube_domain:
    type: http
    behavior: domain
    format: yaml
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/youtube.yaml"
    path: ./ruleset/youtube_domain.yaml
    interval: 86400
  google_domain:
    type: http
    behavior: domain
    format: yaml
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/google.yaml"
    path: ./ruleset/google_domain.yaml
    interval: 86400
  github_domain:
    type: http
    behavior: domain
    format: yaml
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/github.yaml"
    path: ./ruleset/github_domain.yaml
    interval: 86400
  gfw_domain:
    type: http
    behavior: domain
    format: yaml
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/gfw.yaml"
    path: ./ruleset/gfw_domain.yaml
    interval: 86400
  China:
    type: http
    behavior: classical
    url: "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/China/China.yaml"
    path: ./ruleset/China.yaml
    interval: 86400
  cn_domain:
    type: http
    behavior: domain
    format: yaml
    url: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/cn.yaml"
    path: ./ruleset/cn_domain.yaml
    interval: 86400

# 顺序：🚀 节点选择 → 🤖 AI → 📱 社交媒体 → 🇨🇳 中国 → 🐟 漏网之鱼（漏网之鱼最后）
proxy-groups:
  - name: "🚀 节点选择"
    type: select
    proxies:
@@PROXY_NAMES@@
      - DIRECT
  - name: "🤖 AI"
    type: select
    include-all: true
    proxies:
      - "🚀 节点选择"
      - DIRECT
  - name: "📱 社交媒体"
    type: select
    include-all: true
    proxies:
      - "🚀 节点选择"
      - DIRECT
  - name: "🇨🇳 中国"
    type: select
    include-all: true
    proxies:
      - DIRECT
      - "🚀 节点选择"
  - name: "🐟 漏网之鱼"
    type: select
    include-all: true
    proxies:
      - "🚀 节点选择"
      - DIRECT

rules:
  - RULE-SET,private_domain,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - RULE-SET,AI-OpenAI,🤖 AI
  - RULE-SET,AI-Global,🤖 AI
  - RULE-SET,ai_non_cn,🤖 AI
  - RULE-SET,Twitter,📱 社交媒体
  - RULE-SET,Instagram,📱 社交媒体
  - RULE-SET,telegram_domain,📱 社交媒体
  - RULE-SET,youtube_domain,📱 社交媒体
  - RULE-SET,telegram_ip,📱 社交媒体,no-resolve
  - RULE-SET,github_domain,🚀 节点选择
  - RULE-SET,google_domain,🚀 节点选择
  - RULE-SET,gfw_domain,🚀 节点选择
  - RULE-SET,China,🇨🇳 中国
  - RULE-SET,cn_domain,🇨🇳 中国
  - DOMAIN-SUFFIX,cn,DIRECT
  - GEOIP,LAN,DIRECT,no-resolve
  - GEOIP,CN,DIRECT,no-resolve
  - MATCH,🐟 漏网之鱼
