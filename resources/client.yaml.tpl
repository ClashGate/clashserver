# Generated by clashserver install.sh. Contains secrets - keep private.
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: true
unified-delay: true

proxies:
@@PROXIES@@

proxy-groups:
  - name: PROXY
    type: select
    proxies:
@@PROXY_NAMES@@
      - DIRECT

rules:
  - GEOIP,LAN,DIRECT,no-resolve
  - GEOIP,CN,DIRECT
  - MATCH,PROXY
